{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "rootDir": "."
    },
    "include": ["pages/**/*.ts", "tests/**/*.ts", "fixtures/**/*.ts", "playwright.config.ts"],
    "exclude": ["node_modules", "dist"]
}

